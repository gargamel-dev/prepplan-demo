# Copy this file to .env for LOCAL testing only, and fill in your own key.
# Never share .env, and never paste a key into index.html.
# For the deployed website, put this same key in Vercel's environment variables instead.
ANTHROPIC_API_KEY=
# Optional: change the model. Default is claude-haiku-4-5 (fast and cheap for a demo).
# ANTHROPIC_MODEL=claude-haiku-4-5
